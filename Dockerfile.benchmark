# CUDA, Python, curl и декодирование PyAV уже есть в готовом образе Whisper.
# Сборка не использует apt и не зависит от deb.debian.org.
ARG WHISPER_IMAGE=hwdsl2/whisper-server@sha256:de716f26601229179eb4ba62d07e7a5ed4167c5290786281cd06535fdf2a97d6
FROM ${WHISPER_IMAGE} AS models
COPY scripts/download_models.sh /tmp/download_models.sh
# GigaAM CUDA скачает официальный PyTorch checkpoint при ручном запуске.
RUN DOWNLOAD_ASR=0 sh /tmp/download_models.sh /models

FROM ${WHISPER_IMAGE} AS runtime
# Окружение GigaAM отдельно от библиотек Whisper в базовом образе.
RUN /usr/bin/python3 -m venv /opt/gigaam-venv
ENV PATH=/opt/gigaam-venv/bin:$PATH \
    PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    MODELS_DIR=/models EMO_CACHE=/cache/gigaam HOME=/tmp TMPDIR=/tmp \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    LD_LIBRARY_PATH=/opt/gigaam-venv/lib/python3.12/site-packages/nvidia/cublas/lib:/opt/gigaam-venv/lib/python3.12/site-packages/nvidia/cudnn/lib:/opt/gigaam-venv/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:/opt/gigaam-venv/lib/python3.12/site-packages/nvidia/cufft/lib:/opt/gigaam-venv/lib/python3.12/site-packages/nvidia/curand/lib:/opt/gigaam-venv/lib/python3.12/site-packages/nvidia/cusparse/lib:/opt/gigaam-venv/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib:${LD_LIBRARY_PATH}
RUN pip install --index-url https://download.pytorch.org/whl/cu128 torch==2.10.0 torchaudio==2.10.0
COPY requirements.txt /tmp/app-requirements.txt
COPY benchmark/requirements.txt /tmp/benchmark-requirements.txt
RUN sed '/^sherpa-onnx==/d; /^onnxruntime==/d' /tmp/app-requirements.txt > /tmp/gpu-requirements.txt \
 && pip install -r /tmp/gpu-requirements.txt -r /tmp/benchmark-requirements.txt
ARG GIGAAM_REF=7447938d791c4f3e643386ee22c33777004293a5
RUN pip install "gigaam @ https://github.com/salute-developers/GigaAM/archive/${GIGAAM_REF}.zip" \
 && pip uninstall -y onnxruntime \
 && pip install onnxruntime-gpu==1.24.4
# Прямой CUDA wheel из официального каталога sherpa-onnx: индекс github.io
# недоступен с сервера. Ревизия и SHA256 фиксируют файл для Python 3.12/Linux x64.
# Зависимости уже установлены выше; pip не обращается к другим индексам.
RUN pip install --no-deps \
    'sherpa-onnx @ https://huggingface.co/csukuangfj2/sherpa-onnx-wheels/resolve/4de10716b1043c13380c79f3f12127a6c6429650/cuda/1.13.4/sherpa_onnx-1.13.4%2Bcuda12.cudnn9-cp312-cp312-linux_x86_64.whl#sha256=76ffc8a204a00df51d2d8e87f38c204640370b45c24c33f0e1b87d846aeb6c52'
# CUDA wheel связан с ALSA даже при обработке файлов без звукового устройства.
# В Ubuntu 24.04 базового образа её нет. Прямые пакеты с SHA256 сохраняют
# сборку без apt; отдельный слой оставляет тяжёлые Python/CUDA-пакеты в кеше.
RUN curl -fL --retry 3 --connect-timeout 20 --max-time 120 \
      -o /tmp/libasound2-data.deb \
      https://security.ubuntu.com/ubuntu/pool/main/a/alsa-lib/libasound2-data_1.2.11-1ubuntu0.3_all.deb \
 && echo '0c26896193480d9dbb055e85e8ddfb9c9f34cf19afee340987cd6311e2886fc1  /tmp/libasound2-data.deb' | sha256sum -c - \
 && curl -fL --retry 3 --connect-timeout 20 --max-time 120 \
      -o /tmp/libasound2.deb \
      https://security.ubuntu.com/ubuntu/pool/main/a/alsa-lib/libasound2t64_1.2.11-1ubuntu0.3_amd64.deb \
 && echo '5d17bfb5683eb99f1be951fe48e1be5bf3c52391913b6b74a8aecf9b4f5e779f  /tmp/libasound2.deb' | sha256sum -c - \
 && dpkg -i /tmp/libasound2-data.deb /tmp/libasound2.deb \
 && rm /tmp/libasound2-data.deb /tmp/libasound2.deb
# Импорт проверяет системные зависимости до запуска Ollama и GPU-прогона.
# Модели не загружаются, GPU и аудио для этой проверки не нужны.
RUN python -c 'import torch; import onnxruntime; import sherpa_onnx; print("GigaAM: импорт CUDA-библиотек проверен; sherpa-onnx", sherpa_onnx.__version__, "ONNX Runtime", onnxruntime.__version__)'
RUN useradd --system --uid 10001 --no-create-home app \
 && mkdir -p /cache/gigaam \
 && chown -R app /cache
COPY --from=models /models /models
WORKDIR /srv
COPY app /srv/app
COPY benchmark /srv/benchmark
USER app
HEALTHCHECK NONE
ENTRYPOINT ["python", "-m", "benchmark.compare"]
CMD []
