# Загрузчики весов используют сеть сервера; обработка — внутренние сети.
# Для скриптов запуска переопределения передаются переменными перед командой.
BENCH_BUILD_NETWORK=default
BENCH_DOWNLOAD_NETWORK=host

# Собственная тестовая копия образа рабочего Whisper. Ключ/адрес прода не нужны.
BENCH_WHISPER_IMAGE=hwdsl2/whisper-server@sha256:de716f26601229179eb4ba62d07e7a5ed4167c5290786281cd06535fdf2a97d6
BENCH_WHISPER_MODEL=large-v3
BENCH_WHISPER_THREADS=2
BENCH_WHISPER_BEAM=5
BENCH_EXPECTED_FILES=100
BENCH_API_GAP=5
BENCH_API_TIMEOUT=1200
