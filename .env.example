# Скопируйте этот файл в .env и поменяйте нужное. Без .env действуют значения ниже.

# --- Адрес интерфейса: http://localhost:8080
APP_PORT=8080

# --- Распознавание
# Потоков процессора на распознавание текста и на векторы голоса.
ASR_THREADS=4
SPK_THREADS=2

# --- Детектор речи
# Порог вероятности речи (0–1). Выше — меньше ложных срабатываний на шум, но тихая речь может пропасть.
VAD_THRESHOLD=0.5
# Пауза (секунды), после которой фраза считается законченной. Меньше — текст появляется быстрее,
# но длинные фразы чаще режутся на части.
VAD_MIN_SILENCE=0.45
# Самая длинная реплика без пауз, секунды (у модели распознавания предел 25).
VAD_MAX_SPEECH=15

# --- Собеседники
# Строгость разделения голосов (0.25–0.70). Ниже — похожие голоса чаще сливаются в одного,
# выше — один человек может раздвоиться. Меняется и на лету в настройках интерфейса.
SPEAKER_THRESHOLD=0.45
# Потолок числа собеседников (не больше 5: у каждого свой цвет).
MAX_SPEAKERS=5
# Делить реплику, если голос сменился без паузы.
SPLIT_TURNS=true

# --- Эмоции по тону (GigaAM-Emo). Веса скачиваются при первом запуске с серверов Сбера.
EMO_ENABLED=true
EMO_THREADS=2

# --- Разбор разговора текстовой LLM (Ollama в соседнем контейнере)
LLM_ENABLED=true
# Любая модель, которую умеет Ollama. По умолчанию GigaChat 3.1 Lightning, файл 6,5 ГБ.
LLM_MODEL=hf.co/ai-sage/GigaChat3.1-10B-A1.8B-GGUF:Q4_K_M
# Скачать модель при первом запуске автоматически.
LLM_AUTOPULL=true
# Размер контекста в токенах. Больше — длиннее разговор помещается целиком, но нужно больше памяти.
LLM_NUM_CTX=8192
# Сколько держать модель в памяти после разбора. На машине с 16 ГБ лучше выгружать быстро.
LLM_KEEP_ALIVE=1m
# Адрес Ollama. Чтобы использовать Ollama, запущенную на самом Mac (быстрее, с видеоядром Apple):
# OLLAMA_URL=http://host.docker.internal:11434

# --- Если Docker Hub или GitHub недоступны из вашей сети — укажите зеркала
# PYTHON_IMAGE=<адрес-зеркала>/library/python:3.13-slim
# OLLAMA_IMAGE=<адрес-зеркала>/ollama/ollama:latest
# MODELS_BASE_URL=https://github.com/k2-fsa/sherpa-onnx/releases/download

LOG_LEVEL=INFO
